# Copy this file to .env at the project root before running `make up` /
# `docker compose up`. Docker Compose reads a root-level .env automatically.

# Required
SECRET_KEY=                    # generate with: python -c "import secrets; print(secrets.token_hex(32))"
OPENAI_API_KEY=
# Use API models available to your account; see README for parameter requirements.
CHAT_MODEL=gpt-5.6-terra
FAST_MODEL=gpt-5.6-luna
EMBEDDING_MODEL=text-embedding-3-small

# Optional (sensible defaults for local development)
ENVIRONMENT=development
POSTGRES_PASSWORD=meridian_dev_password
ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
