# Copy to .env and fill in. Every value has a safe default for local
# development except the two marked REQUIRED below.

APP_NAME=Meridian
ENVIRONMENT=development          # development | staging | production
DEBUG=false

# --- Security -----------------------------------------------------------
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# The app refuses to start with ENVIRONMENT=production if this is left as
# the placeholder value below.
SECRET_KEY=change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
ALLOWED_ORIGINS=http://localhost:5173   # comma-separated; never "*" in production

# --- Database -------------------------------------------------------------
# SQLite is fine for local development. Use Postgres in staging/production
# (docker-compose.yml already does this for you).
DATABASE_URL=sqlite:///./meridian.db

# --- Redis (Celery broker + optional shared rate-limit storage) -----------
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_STORAGE_URI=memory://   # point at Redis once you run >1 API replica
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_DEFAULT=120/minute

# --- OpenAI ---------------------------------------------------------------
# REQUIRED.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-5.6-terra    # extraction, qualification, RAG answers
FAST_MODEL=gpt-5.6-luna     # cheaper/faster tier for lower-stakes generation

# --- Vector store (ChromaDB) -----------------------------------------------
# A shared server is required when the API and Celery worker run separately.
# Start it with: chroma run --path ./chroma_db --port 8001
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=meridian_docs

# --- Document processing ---------------------------------------------------
UPLOAD_DIR=./uploads
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_UPLOAD_SIZE_MB=20

# --- RAG --------------------------------------------------------------------
TOP_K_RESULTS=5
MIN_SIMILARITY_SCORE=0.3
